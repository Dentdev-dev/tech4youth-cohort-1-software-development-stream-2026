PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://user:password@localhost:5432/fundamental

# Use a long random string, e.g. `openssl rand -hex 64`
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=1d

# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx...)
TRUST_PROXY=0

# Front-end URL used to build the reset link: {CLIENT_URL}/reset-password?token=...
CLIENT_URL=http://localhost:5173
PASSWORD_RESET_EXPIRES_MINUTES=15

# Gmail SMTP. SMTP_PASS must be a Google *App Password*
# (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Your Store <your-address@gmail.com>"
